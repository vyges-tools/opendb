Header:
  version: "1.0"
  unit: "micron"
  precision: 2000
  include:
    - twoproc.3dbv

Design:
  name: "TwoProc"

ChipletInst:
  a:
    reference: DieA
  b:
    reference: DieB

Stack:
  a:
    loc: [0.0, 0.0]
    z: 0.0
    orient: R0
  b:
    loc: [0.0, 0.0]
    z: 50.0
    orient: R0

Connection:
  bond:
    top: b.regions.down
    bot: a.regions.up
