VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 20000 ) ;
PINS 2 ;
- in_a + NET n_in + DIRECTION INPUT + USE SIGNAL ;
- in_b + NET n_in + DIRECTION INPUT + USE SIGNAL ;
END PINS
COMPONENTS 1 ;
- u1 BUF_X1 ;
END COMPONENTS
NETS 1 ;
- n_in ( PIN in_a ) ( PIN in_b ) ( u1 A ) ;
END NETS
END DESIGN
