VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN bal ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 20000 10000 ) ;
COMPONENTS 1 ;
- b0 blk + FIXED ( 1000 6000 ) N ;
END COMPONENTS
SPECIALNETS 1 ;
- VSS ( * VSS ) + USE GROUND
  + ROUTED M1 1000 + SHAPE STRIPE ( 0 2000 ) MASK 1 ( 8000 2000 )
  NEW M1 1000 + SHAPE STRIPE ( 11000 2000 ) MASK 1 ( 19000 2000 )
  NEW M2 1000 + SHAPE STRIPE ( 5000 0 ) MASK 2 ( 5000 10000 )
  NEW M3 1000 + SHAPE STRIPE ( 0 9000 ) ( 20000 9000 ) ;
END SPECIALNETS
NETS 1 ;
- n1
  + ROUTED M1 ( 12000 9000 ) MASK 2 ( 18000 9000 ) ;
END NETS
FILLS 2 ;
- LAYER M1 + MASK 2 RECT ( 11000 6000 ) ( 15000 7000 ) ;
- LAYER M1 + MASK 1 RECT ( 11000 1500 ) ( 13000 2500 ) ;
END FILLS
END DESIGN
