VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN eolml ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 3000 3000 ) ;
GCELLGRID X 0 DO 4 STEP 1000 ;
GCELLGRID Y 0 DO 4 STEP 1000 ;
TRACKS Y 50 DO 30 STEP 100 LAYER M1 ;
TRACKS X 50 DO 30 STEP 100 LAYER M2 ;
NETS 10 ;
- w + ROUTED M2 ( 1050 2000 ) ( * 1100 ) ( 1100 * ) ;
- n1 + ROUTED M2 ( 1150 1225 ) ( 1250 * ) ;
- n2 + ROUTED M2 ( 1150 975 ) ( 1250 * ) ;
- x + ROUTED M2 ( 1550 2000 ) ( * 1100 ) ( 1580 * ) ;
- n3 + ROUTED M2 ( 1630 1225 ) ( 1730 * ) ;
- n4 + ROUTED M2 ( 1630 975 ) ( 1730 * ) ;
- y + ROUTED M2 ( 2050 2000 ) ( * 1100 ) ( 2070 * ) ;
- n5 + ROUTED M2 ( 2120 1225 ) ( 2220 * ) ;
- n6 + ROUTED M2 ( 2120 975 ) ( 2220 * ) ;
- z + ROUTED M2 ( 2550 1100 ) ( * 2000 ) ;
END NETS
END DESIGN
