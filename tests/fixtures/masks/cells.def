VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN cells ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 2000 2000 ) ;
TRACKS Y 50 DO 20 STEP 100 LAYER M1 ;
TRACKS X 50 DO 20 STEP 100 LAYER M2 ;
TRACKS Y 100 DO 10 STEP 200 LAYER M3 ;
COMPONENTS 1 ;
- u1 CM + PLACED ( 300 0 ) N ;
END COMPONENTS
NETS 1 ;
- n ( u1 A )
  + ROUTED M1 ( 50 50 ) ( 450 50 ) ;
END NETS
END DESIGN
