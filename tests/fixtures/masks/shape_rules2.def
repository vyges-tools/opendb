VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN sr2 ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 7000 5000 ) ;
GCELLGRID X 0 DO 2 STEP 7000 ;
GCELLGRID Y 0 DO 2 STEP 5000 ;
TRACKS Y 50 DO 50 STEP 100 LAYER M1 ;
TRACKS X 50 DO 70 STEP 100 LAYER M2 ;
NETS 7 ;
- st + ROUTED M2 ( 3025 125 ) ( * 1975 ) NEW M2 ( 3065 1000 ) ( * 1975 ) ;
- sn + ROUTED M2 ( 3085 895 ) ( 3375 * ) ;
- uu + ROUTED M2 ( 5025 1000 ) ( * 2000 ) NEW M2 ( 5275 1000 ) ( * 2125 ) NEW M2 ( 5025 1000 ) ( 5275 * ) NEW M2 ( 5050 2125 ) ( 5275 * ) ;
- l1 + ROUTED M2 ( 4000 4000 ) ( 4500 * ) ;
- r1 + ROUTED M2 ( 4680 4000 ) ( 5200 * ) ;
- h1 + ROUTED M2 ( 6025 1000 ) ( * 2000 ) ;
- h2 + ROUTED M2 ( 6025 2080 ) ( * 2500 ) ;
END NETS
END DESIGN
